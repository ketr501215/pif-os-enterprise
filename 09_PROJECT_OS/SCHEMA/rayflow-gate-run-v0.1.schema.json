{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pif-os.example/schema/rayflow-gate-run-v0.1.json",
  "title": "RayFlow Role Gate Run v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "task_id", "attempt_id", "requirement_revision", "idempotency_key", "actor", "subject_builder", "role_assignment_ref", "role_assignment_sha256", "current_state", "target_state", "resulting_state", "evidence_inputs", "checks", "declared_effective_verdict", "created_at"],
  "properties": {
    "schema_version": {"const": "rayflow.gate-run/v0.1"},
    "policy_id": {"const": "RAYFLOW-ROLE-GATES-001"},
    "task_id": {"type": "string", "minLength": 3},
    "attempt_id": {"type": "string", "minLength": 1},
    "requirement_revision": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actor": {"$ref": "#/$defs/identity"},
    "subject_builder": {"anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
    "role_assignment_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+"},
    "role_assignment_sha256": {"$ref": "#/$defs/sha256"},
    "current_state": {"$ref": "#/$defs/state"},
    "target_state": {"$ref": "#/$defs/state"},
    "resulting_state": {"$ref": "#/$defs/state"},
    "evidence_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "declared_effective_verdict": {"$ref": "#/$defs/verdict"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "state": {"enum": ["CREATED", "DISPATCHED", "ACCEPTED", "RUNNING", "PRODUCED", "PERSISTED", "PUBLISHED", "OBSERVED", "ACKED", "VERIFIED", "CLOSED"]},
    "verdict": {"enum": ["PASS", "BLOCK", "DEGRADED", "UNKNOWN"]},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "role", "vendor", "credential_ref", "session_id", "machine_id", "site"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["HUMAN", "LEAD", "ORCHESTRATOR", "PLANNER", "BUILDER", "VERIFIER", "ADVERSARY"]},
        "vendor": {"type": "string", "minLength": 1},
        "credential_ref": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "machine_id": {"type": "string", "minLength": 1},
        "site": {"enum": ["HOME", "SCHOOL", "CLOUD", "OTHER"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "critical", "expected", "observed", "comparison", "verdict", "evidence_ref"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "critical": {"type": "boolean"},
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "comparison": {"enum": ["MATCH", "MISMATCH", "MISSING", "STALE", "NOT_RUN", "DEGRADED"]},
        "verdict": {"$ref": "#/$defs/verdict"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
